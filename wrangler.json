{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jm-webflow",
  "compatibility_date": "2025-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "kv_namespaces": [
    { "binding": "SYNC_STATE" }
  ],
  "observability": {
    "enabled": true
  }
}
